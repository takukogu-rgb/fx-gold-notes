"createdAt": "2026-11-20T01:15:12+09:00"}, {"id": "n20261119-minutes", "date": "2026-11-19", "title": "FOMC議事要旨がタカ派、ほぼ全員が12月利上げを想定", "summary": "10月FOMCの議事要旨で、ほぼ全員の参加者が12月の追加利上げを見込んでいることが分かった。金は一時3,703ドルまで下げた後に小反発。", "impact": "bear", "strength": 3, "factors": ["fed", "realyield"], "source": "FX Leaders", "url": "https://www.fxleaders.com/news/2026/11/19/gold-price-forecast-xau-usd-rebounds-from-3703-after-hawkish-fed-minutes/", "createdAt": "2026-11-20T01:00:00+09:00"}, {"id": "n20261119-iran", "date": "2026-11-19", "title": "米国がイランへの追加攻撃を検討との報道、ドル高で金は3,715ドル付近", "summary": "地政学リスクは本来は金の買い材料だが、今回はドル買いにつながり、金は小幅安で横ばい。", "impact": "neutral", "strength": 2, "factors": ["geo", "usd"], "source": "USAGOLD", "url": "https://www.usagold.com/daily-precious-metals-market-report-november-19-2026/", "createdAt": "2026-11-20T01:00:00+09:00"}, {"id": "n20261119-gs", "date": "2026-11-19", "title": "ゴールドマン、2026年末の金予想を4,150ドルに引き下げ", "summary": "足元の金利上昇による調整を反映して予想を下げた。中銀が四半期に数十トン買い続けるという前提は維持。個人の売りと中銀の買いが分かれている。", "impact": "neutral", "strength": 1, "factors": ["cb", "etf"], "source": "CNBC", "url": "https://www.cnbc.com/2026/11/19/gold-prices-fall-fed-rates-dollar.html", "createdAt": "2026-11-20T01:00:00+09:00"}, {"id": "n-wgc-q3", "date": "2026-11-19", "title": "Q3の中銀の金購入は約321トン、前年比+42%", "summary": "WGCのQ3レポート（二次報道）。金価格が下げる中でも、中央銀行の買いは強いまま。", "impact": "bull", "strength": 2, "factors": ["cb"], "source": "Golden Star International", "url": "https://goldenstar.org.uk/gold-price-drop-november-2026/", "createdAt": "2026-11-20T01:00:00+09:00"}, {"id": "n20261118-low", "date": "2026-11-18", "title": "金が3,800ドル割れ、14か月ぶり安値。ドルは19か月ぶり高値", "summary": "FRB高官のタカ派発言で12月利上げの確率が約95%に上がり、ドルと米金利が上昇。スポット金は1日で2.9%下げて3,739ドル。", "impact": "bear", "strength": 3, "factors": ["usd", "fed"], "source": "CNBC", "url": "https://www.cnbc.com/2026/11/18/gold-slides-to-over-one-year-low-on-firm-dollar-us-rate-outlook.html", "createdAt": "2026-11-20T01:00:00+09:00"}, {"id": "n20261118-yield", "date": "2026-11-18", "title": "金の最大の重しは5%台の米10年債利回り", "summary": "中東の材料より、米長期金利の高止まりが金の上値を抑えているという分析。利息を生まない金を持つコストが上がっている。", "impact": "bear", "strength": 2, "factors": ["realyield"], "source": "Shanghai Metals Market", "url": "https://news.metal.com/newscontent/FXUEZDIJJ4MHVITU44RAZECRHV5YEC7BNJ7J3QQ-golds-worst-enemy-right-now-is-a-5-treasury-yield-not-the-headlines-from-the-middle-east", "createdAt": "2026-11-20T01:00:00+09:00"}, {"id": "n20261111-infl", "date": "2026-11-11", "title": "インフレ懸念の広がりで金が反落", "summary": "物価上昇の広がりが利上げ観測を強め、金は売られた。短期ではインフレがヘッジ買いより利上げ材料として効いている。", "impact": "bear", "strength": 2, "factors": ["inflation", "fed"], "source": "Yahoo Finance", "url": "https://finance.yahoo.com/personal-finance/investing/article/gold-price-today-wednesday-november-11-2026-gold-prices-fall-back-as-inflation-concerns-broaden-121148323.html", "createdAt": "2026-11-20T01:00:00+09:00"}], "history": [{"t": "2026-11-20T01:06:05+09:00", "score": -11, "changed": {}, "f": {"fed": "bear", "realyield": "bear", "usd": "bear", "inflation": "bear", "cb": "bull", "etf": "bear", "geo": "neutral", "risk": "neutral", "fiscal": "bull", "physical": "bear"}}, {"t": "2026-11-20T01:06:26+09:00", "score": -11, "changed": {}, "f": {"fed": "bear", "realyield": "bear", "usd": "bear", "inflation": "bear", "cb": "bull", "etf": "bear", "geo": "neutral", "risk": "neutral", "fiscal": "bull", "physical": "bear"}}, {"t": "2026-11-20T01:15:12+09:00", "score": -11, "changed": {}, "f": {"fed": "bear", "realyield": "bear", "usd": "bear", "inflation": "bear", "cb": "bull", "etf": "bear", "geo": "neutral", "risk": "neutral", "fiscal": "bull", "physical": "bear"}}, {"t": "2026-11-20T01:18:00+09:00", "score": -11, "changed": {}, "f": {"fed": "bear", "realyield": "bear", "usd": "bear", "inflation": "bear", "cb": "bull", "etf": "bear", "geo": "neutral", "risk": "neutral", "fiscal": "bull", "physical": "bear"}}, {"t": "2026-11-20T01:18:58+09:00", "score": -11, "changed": {}, "f": {"fed": "bear", "realyield": "bear", "usd"